import java_cup.runtime.*;

parser code {:
    // conectar esse parser ao scanner!
    Scanner s;
    Parser(Scanner s){ this.s=s; }
    
    // tabela de símbolos
    java.util.Map<String, Integer> simbolos = new java.util.HashMap<String, Integer>();

    java.io.PrintWriter resultado;

    private boolean erroSintatico = false;

    public Parser(Scanner s, java.io.PrintWriter resultado) {
        this.s = s;
        this.resultado = resultado;
    }

    public boolean houveErroSintatico() {
        return erroSintatico;
    }

    @Override
    public void syntax_error(java_cup.runtime.Symbol cur_token) {
        erroSintatico = true;

         TokenInfo token = (TokenInfo) cur_token;

        resultado.println("Erro sintático!");
        resultado.println("Token encontrado: " + cur_token.value);
        resultado.println("Linha: " + token.linha);
        resultado.println("Coluna: " + token.coluna);
    }

    @Override
    public void unrecovered_syntax_error(
        java_cup.runtime.Symbol cur_token
    ) throws java.lang.Exception {
        erroSintatico = true;

        throw new java.lang.Exception(
            "Não foi possível recuperar a análise sintática."
        );
    }
    private int linha(AstNode no) {
        return no != null ? no.getLinha() : 0;
    }
:}

/* conectar esse parser ao scanner! */
init with {:  :};
scan with {: return s.next_token(); :};

terminal ELSE, EXIT, FLOAT, IF, INT, READ, RETURN, WHILE, WRITE;
terminal AND, OR, NOT;
terminal EQ, NE, GT, GE, LT, LE;
terminal PLUS, MINUS, TIMES, DIVIDE;
terminal ASSIGN;
terminal CM, SC, LBR, RBR, LBK, RBK, LP, RP, SQ;
terminal String IDENTIFIER, INTCON, FLOATCON, STRING;
terminal ERROR;

/* =====================================================
   NÃO TERMINAIS
   ===================================================== */

non terminal AstNode Program;
non terminal AstNode DeclList;
non terminal AstNode Procedures;
non terminal AstNode ProcedureDecl;
non terminal AstNode ProcedureHead;
non terminal AstNode FunctionDecl;
non terminal AstNode ProcedureBody;
non terminal AstNode IdentifierList;
non terminal AstNode VarDecl;
non terminal AstNode Type;

non terminal AstNode StatementList;
non terminal AstNode Statement;
non terminal AstNode Assignment;
non terminal AstNode IfStatement;
non terminal AstNode TestAndThen;
non terminal AstNode Test;
non terminal AstNode WhileStatement;
non terminal AstNode IOStatement;
non terminal AstNode ReturnStatement;
non terminal AstNode ExitStatement;
non terminal AstNode CompoundStatement;

non terminal AstNode Expr;
non terminal AstNode AndExpr;
non terminal AstNode NotExpr;
non terminal AstNode SimpleExpr;
non terminal AstNode AddExpr;
non terminal AstNode MulExpr;
non terminal AstNode Factor;
non terminal AstNode Variable;
non terminal AstNode Constant;
non terminal AstNode StringConstant;

start with Program;



/* =====================================================
   REGRAS GRAMATICAIS COM AÇÕES SEMÂNTICAS E LINHAS
   ===================================================== */


/* ---------------- PROGRAM ---------------- */

Program ::=
      DeclList:d Procedures:p
      {:
          RESULT = new AstNode("Program", linha(d), d, p);
      :}
    | Procedures:p
      {:
          RESULT = new AstNode("Program", linha(p), p);
      :}
    ;


/* ---------------- PROCEDURES ---------------- */

Procedures ::=
      ProcedureDecl:p
      {:
          RESULT = new AstNode("Procedures", linha(p), p);
      :}
    | ProcedureDecl:p Procedures:ps
      {:
          RESULT = new AstNode("Procedures", linha(p), p, ps);
      :}
    ;

ProcedureDecl ::=
    ProcedureHead:h ProcedureBody:b
    {:
        RESULT = new AstNode("ProcedureDecl", linha(h), h, b);
    :}
    ;

ProcedureHead ::=
      FunctionDecl:f DeclList:d
      {:
          RESULT = new AstNode("ProcedureHead", linha(f), f, d);
      :}
    | FunctionDecl:f
      {:
          RESULT = new AstNode("ProcedureHead", linha(f), f);
      :}
    ;

FunctionDecl ::=
    Type:t IDENTIFIER:id LP RP LBR
    {:
        RESULT = new AstNode(
            "FunctionDecl: " + id,
            linha(t),
            t
        );
    :}
    ;

ProcedureBody ::=
    StatementList:s RBR
    {:
        RESULT = new AstNode("ProcedureBody", linha(s), s);
    :}
    ;


/* ---------------- DECLARAÇÕES ---------------- */

DeclList ::=
      Type:t IdentifierList:i SC
      {:
          RESULT = new AstNode(
              "DeclList",
              linha(t),
              t, i
          );
      :}
    | DeclList:d Type:t IdentifierList:i SC
      {:
          RESULT = new AstNode(
              "DeclList",
              linha(d),
              d, t, i
          );
      :}
    ;

IdentifierList ::=
      VarDecl:v
      {:
          RESULT = new AstNode(
              "IdentifierList",
              linha(v),
              v
          );
      :}
    | IdentifierList:i CM VarDecl:v
      {:
          RESULT = new AstNode(
              "IdentifierList",
              linha(i),
              i, v
          );
      :}
    ;

VarDecl ::=
      IDENTIFIER:id
      {:
          RESULT = new AstNode(
              "VariableDeclaration: " + id,
              idleft
          );
      :}
    | IDENTIFIER:id LBK INTCON:n RBK
      {:
          RESULT = new AstNode(
              "ArrayDeclaration: " + id + "[" + n + "]",
              idleft
          );
      :}
    ;

Type ::=
      INT:t
      {:
          RESULT = new AstNode("Type: int", tleft);
      :}
    | FLOAT:t
      {:
          RESULT = new AstNode("Type: float", tleft);
      :}
    ;


/* ---------------- COMANDOS ---------------- */

StatementList ::=
      Statement:s
      {:
          RESULT = new AstNode(
              "StatementList",
              linha(s),
              s
          );
      :}
    | StatementList:sl Statement:s
      {:
          RESULT = new AstNode(
              "StatementList",
              linha(sl),
              sl, s
          );
      :}
    ;

Statement ::=
      Assignment:a
      {:
          RESULT = a;
      :}
    | IfStatement:i
      {:
          RESULT = i;
      :}
    | WhileStatement:w
      {:
          RESULT = w;
      :}
    | IOStatement:io
      {:
          RESULT = io;
      :}
    | ReturnStatement:r
      {:
          RESULT = r;
      :}
    | ExitStatement:e
      {:
          RESULT = e;
      :}
    | CompoundStatement:c
      {:
          RESULT = c;
      :}
    ;


/* ---------------- ATRIBUIÇÃO ---------------- */

Assignment ::=
    Variable:v ASSIGN Expr:e SC
    {:
        RESULT = new AstNode(
            "Assignment",
            linha(v),
            v, e
        );
    :}
    ;


/* ---------------- IF / ELSE ---------------- */

IfStatement ::=
      IF:inicio TestAndThen:t ELSE CompoundStatement:c
      {:
          RESULT = new AstNode(
              "IfElse",
              inicioleft,
              t, c
          );
      :}
    | IF:inicio TestAndThen:t
      {:
          RESULT = new AstNode(
              "If",
              inicioleft,
              t
          );
      :}
    ;

TestAndThen ::=
    Test:t CompoundStatement:c
    {:
        RESULT = new AstNode(
            "TestAndThen",
            linha(t),
            t, c
        );
    :}
    ;

Test ::=
    LP:inicio Expr:e RP
    {:
        RESULT = new AstNode(
            "Test",
            inicioleft,
            e
        );
    :}
    ;


/* ---------------- WHILE ---------------- */

WhileStatement ::=
    WHILE:inicio LP Expr:e RP Statement:s
    {:
        RESULT = new AstNode(
            "While",
            inicioleft,
            e, s
        );
    :}
    ;


/* ---------------- ENTRADA E SAÍDA ---------------- */

IOStatement ::=
      READ:inicio LP Variable:v RP SC
      {:
          RESULT = new AstNode(
              "Read",
              inicioleft,
              v
          );
      :}
    | WRITE:inicio LP Expr:e RP SC
      {:
          RESULT = new AstNode(
              "Write",
              inicioleft,
              e
          );
      :}
    | WRITE:inicio LP StringConstant:s RP SC
      {:
          RESULT = new AstNode(
              "Write",
              inicioleft,
              s
          );
      :}
    ;


/* ---------------- RETURN ---------------- */

ReturnStatement ::=
    RETURN:inicio Expr:e SC
    {:
        RESULT = new AstNode(
            "Return",
            inicioleft,
            e
        );
    :}
    ;


/* ---------------- EXIT ---------------- */

ExitStatement ::=
    EXIT:inicio SC
    {:
        RESULT = new AstNode("Exit", inicioleft);
    :}
    ;


/* ---------------- BLOCO COMPOSTO ---------------- */

CompoundStatement ::=
    LBR:inicio StatementList:s RBR
    {:
        RESULT = new AstNode(
            "CompoundStatement",
            inicioleft,
            s
        );
    :}
    ;


/* =====================================================
   EXPRESSÕES
   ===================================================== */


/* ---------------- EXPRESSÕES LÓGICAS ---------------- */

Expr ::=
      Expr:e OR AndExpr:a
      {:
          RESULT = new AstNode(
              "OR",
              linha(e),
              e, a
          );
      :}
    | AndExpr:a
      {:
          RESULT = a;
      :}
    ;

AndExpr ::=
      AndExpr:a AND NotExpr:n
      {:
          RESULT = new AstNode(
              "AND",
              linha(a),
              a, n
          );
      :}
    | NotExpr:n
      {:
          RESULT = n;
      :}
    ;

NotExpr ::=
      NOT:inicio SimpleExpr:s
      {:
          RESULT = new AstNode(
              "NOT",
              inicioleft,
              s
          );
      :}
    | SimpleExpr:s
      {:
          RESULT = s;
      :}
    ;


/* ---------------- EXPRESSÕES RELACIONAIS ---------------- */

SimpleExpr ::=
      SimpleExpr:s EQ AddExpr:a
      {:
          RESULT = new AstNode("EQUAL", linha(s), s, a);
      :}
    | SimpleExpr:s NE AddExpr:a
      {:
          RESULT = new AstNode("NOT_EQUAL", linha(s), s, a);
      :}
    | SimpleExpr:s LE AddExpr:a
      {:
          RESULT = new AstNode("LESS_EQUAL", linha(s), s, a);
      :}
    | SimpleExpr:s LT AddExpr:a
      {:
          RESULT = new AstNode("LESS_THAN", linha(s), s, a);
      :}
    | SimpleExpr:s GE AddExpr:a
      {:
          RESULT = new AstNode("GREATER_EQUAL", linha(s), s, a);
      :}
    | SimpleExpr:s GT AddExpr:a
      {:
          RESULT = new AstNode("GREATER_THAN", linha(s), s, a);
      :}
    | AddExpr:a
      {:
          RESULT = a;
      :}
    ;


/* ---------------- EXPRESSÕES ADITIVAS ---------------- */

AddExpr ::=
      AddExpr:a PLUS MulExpr:m
      {:
          RESULT = new AstNode("ADDITION", linha(a), a, m);
      :}
    | AddExpr:a MINUS MulExpr:m
      {:
          RESULT = new AstNode("SUBTRACTION", linha(a), a, m);
      :}
    | MulExpr:m
      {:
          RESULT = m;
      :}
    ;


/* ---------------- EXPRESSÕES MULTIPLICATIVAS ---------------- */

MulExpr ::=
      MulExpr:m TIMES Factor:f
      {:
          RESULT = new AstNode("MULTIPLICATION", linha(m), m, f);
      :}
    | MulExpr:m DIVIDE Factor:f
      {:
          RESULT = new AstNode("DIVISION", linha(m), m, f);
      :}
    | Factor:f
      {:
          RESULT = f;
      :}
    ;


/* ---------------- FATORES ---------------- */

Factor ::=
      Variable:v
      {:
          RESULT = v;
      :}
    | Constant:c
      {:
          RESULT = c;
      :}
    | IDENTIFIER:id LP RP
      {:
          RESULT = new AstNode(
              "FunctionCall: " + id,
              idleft
          );
      :}
    | LP:inicio Expr:e RP
      {:
          RESULT = new AstNode(
              "ParenthesizedExpression",
              inicioleft,
              e
          );
      :}
    ;


/* ---------------- VARIÁVEIS ---------------- */

Variable ::=
      IDENTIFIER:id
      {:
          RESULT = new AstNode(
              "Variable: " + id,
              idleft
          );
      :}
    | IDENTIFIER:id LBK Expr:e RBK
      {:
          RESULT = new AstNode(
              "ArrayAccess: " + id,
              idleft,
              e
          );
      :}
    ;


/* ---------------- CONSTANTES STRING ---------------- */

StringConstant ::=
    STRING:s
    {:
        RESULT = new AstNode(
            "String: " + s,
            sleft
        );
    :}
    ;


/* ---------------- CONSTANTES NUMÉRICAS ---------------- */

Constant ::=
      INTCON:n
      {:
          RESULT = new AstNode(
              "Integer: " + n,
              nleft
          );
      :}
    | FLOATCON:n
      {:
          RESULT = new AstNode(
              "Float: " + n,
              nleft
          );
      :}
    ;


/* =====================================================
   TRATAMENTO DE ERROS
   ===================================================== */

/* Erro léxico recebido do JFlex */

Statement ::=
    ERROR:e
    {:
        RESULT = new AstNode(
            "LexicalError: " + e,
            eleft
        );
    :}
    ;

/* Recuperação de erro sintático até o ponto e vírgula */

Statement ::=
    error SC:fim
    {:
        RESULT = new AstNode(
            "SyntaxError: comando inválido",
            fimleft
        );
    :}
    ;

